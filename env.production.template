# KeepTrack backend production template (no secrets committed)
APP_ENV=production

# Neon (or other managed Postgres) - include sslmode=require
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<database>?sslmode=require

JWT_SECRET=<generate-strong-random-secret>
JWT_ISSUER=keeptrack
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_MINUTES=10080
JWT_EMAIL_VERIFICATION_TTL_MINUTES=1440

SMTP_HOST=smtp-relay.brevo.com
# Render free blocks outbound SMTP on 25/465/587, use Brevo alternative port
SMTP_PORT=2525
SMTP_USERNAME=<brevo-smtp-login>
SMTP_PASSWORD=<brevo-smtp-key>
SMTP_SENDER_EMAIL=<sender@your-domain>
SMTP_SENDER_NAME=KeepTrack

# Must point to frontend public URL
EMAIL_VERIFICATION_URL_BASE=https://<frontend-onrender-domain>/verify-email
